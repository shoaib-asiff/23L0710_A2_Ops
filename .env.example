# VisionGuard MLOps Environment Configuration Template
# Student Roll Number: 23L0710
# Standard Naming: 23L0710_A2_Ops

# ==============================================================================
# 1. DagsHub & Remote MLflow Tracking Credentials (Tasks 3.2 - 3.6)
# ==============================================================================
MLFLOW_TRACKING_URI=https://dagshub.com/<DAGSHUB_USERNAME>/23L0710_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<DAGSHUB_USERNAME>
MLFLOW_TRACKING_PASSWORD=<DAGSHUB_ACCESS_TOKEN>

# ==============================================================================
# 2. Web Application & Inference Settings (Tasks 4, 6, 7 & 8)
# ==============================================================================
SECRET_KEY=replace-with-a-secure-secret-key-in-production
INFERENCE_MODE=local
MODEL_PATH=models/champion.keras
DECISION_THRESHOLD=0.23
PORT=5000
WEB_PORT=5001
HOST=0.0.0.0

# ==============================================================================
# 3. Docker Compose Stack & Database Trail (Tasks 5 & 6.3)
# ==============================================================================
# PostgreSQL container credentials
POSTGRES_USER=visionguard_user
POSTGRES_PASSWORD=replace_with_strong_password_here
POSTGRES_DB=visionguard_db

# Local SQLite Fallback:
# DATABASE_URL=sqlite:///visionguard.db

# Docker Compose PostgreSQL Connection:
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ==============================================================================
# 4. Cloud API Endpoint (Tasks 7 & 8 Remote Integration)
# ==============================================================================
REMOTE_API_URL=https://<your-cloud-hosted-api>/predict
API_KEY=optional_secret_api_key_for_cloud_endpoint
