# VisionGuard MLOps Environment Configuration Template
# Student Roll Number: 23L0710
# Repository / Project: 23L0710_A2_Ops

# ==============================================================================
# 1. DagsHub & Remote MLflow Tracking Credentials (Tasks 3.2 - 3.6)
# ==============================================================================
MLFLOW_TRACKING_URI=https://dagshub.com/<DAGSHUB_USERNAME>/23L0710_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<DAGSHUB_USERNAME>
MLFLOW_TRACKING_PASSWORD=<DAGSHUB_ACCESS_TOKEN>

# ==============================================================================
# 2. Web Application & Inference Settings (Tasks 4, 6, 7 & 8)
# ==============================================================================
# INFERENCE_MODE: 'local' (loads local model file) or 'remote' (calls cloud API)
INFERENCE_MODE=local
CHAMPION_MODEL_PATH=models/best_checkpoint_model.keras
CONFIDENCE_THRESHOLD=0.23
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# ==============================================================================
# 3. Database Trail Configuration (Task 5 & Task 6.3 Compose Stack)
# ==============================================================================
# SQLite Local Fallback:
DATABASE_URL=sqlite:///visionguard.db
# PostgreSQL Container Service:
# DATABASE_URL=postgresql://postgres:postgres_secure_password@db:5432/visionguard_db

# ==============================================================================
# 4. Cloud API Endpoint (Task 7 & Task 8 Remote Integration)
# ==============================================================================
REMOTE_INFERENCE_API_URL=https://<your-cloud-hosted-api>/predict
